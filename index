<script>
(function(){
  var nav=document.getElementById('nav'),menu=document.getElementById('menu');
  menu.addEventListener('click',function(){
    var o=nav.classList.toggle('open');
    menu.setAttribute('aria-expanded',o);
    menu.textContent=o?'✕':'☰';
  });
  nav.addEventListener('click',function(e){
    if(e.target.tagName==='A'){nav.classList.remove('open');menu.setAttribute('aria-expanded','false');menu.textContent='☰'}
  });

  var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function fmt(el,v){el.textContent=v+(el.getAttribute('data-suffix')||'')}
  var counters=document.querySelectorAll('[data-to]');
  function run(el){
    var to=+el.getAttribute('data-to');
    if(reduce){fmt(el,to);return}
    var t0=null;
    function step(t){
      if(!t0)t0=t;
      var p=Math.min((t-t0)/1200,1);
      fmt(el,Math.round(to*(1-Math.pow(1-p,3))));
      if(p<1)requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){
      es.forEach(function(e){if(e.isIntersecting){run(e.target);io.unobserve(e.target)}});
    },{threshold:.5});
    counters.forEach(function(c){io.observe(c)});
  }else{counters.forEach(run)}

  document.getElementById('form').addEventListener('submit',function(e){
    e.preventDefault();
    var f=e.target;
    var body='Name: '+f.name.value+'\nEmail: '+f.email.value+'\n\n'+f.msg.value;
    location.href='mailto:yuvrajsurawanshiyuvraj@gmail.com?subject='+encodeURIComponent('Project enquiry from '+f.name.value)+'&body='+encodeURIComponent(body);
  });
  
  var RESUME="";
  document.querySelectorAll('[data-resume]').forEach(function(a){
    a.addEventListener('click',function(e){
      e.preventDefault();
      var bin=atob(RESUME),u=new Uint8Array(bin.length);
      for(var i=0;i<bin.length;i++)u[i]=bin.charCodeAt(i);
      var url=URL.createObjectURL(new Blob([u],{type:'application/pdf'}));
      var l=document.createElement('a');l.href=url;l.download='Yuvraj_Ayangar_Resume.pdf';
      document.body.appendChild(l);l.click();l.remove();
      setTimeout(function(){URL.revokeObjectURL(url)},4000);
    });
  });
  document.getElementById('y').textContent=new Date().getFullYear();
})();
</script>
