<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Hanken+Grotesk:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0a1330;
  --bg2:#0f1b44;
  --card:#14224f;
  --line:#2a3a6e;
  --text:#eaf1ff;
  --muted:#a4b3d9;
  --sky:#8fbbff;
  --sun:#ffc93c;
  --display:"Bricolage Grotesque","Trebuchet MS",system-ui,sans-serif;
  --body:"Hanken Grotesk",system-ui,-apple-system,"Segoe UI",sans-serif;
  --pad:clamp(20px,5vw,64px);
}
*{box-sizing:border-box;margin:0;padding:0}
html{overflow-x:clip;scroll-behavior:smooth;scroll-padding-top:90px;-webkit-text-size-adjust:100%}
body{font-family:var(--body);background:var(--bg);color:var(--text);line-height:1.65;font-size:1.0625rem;overflow-x:hidden}
a{color:inherit}
img{max-width:100%;display:block}
ul{list-style:none}
:focus-visible{outline:3px solid var(--sun);outline-offset:3px;border-radius:6px}
.wrap{max-width:1180px;margin:0 auto;padding:0 var(--pad)}
h1,h2,h3,h4{font-family:var(--display);line-height:1.06;letter-spacing:-.02em}
h2{font-size:clamp(2rem,4.6vw,3.3rem);font-weight:800}
section{padding:clamp(56px,8vw,104px) 0}
.head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:20px 40px;margin-bottom:44px}
.head p{color:var(--muted);max-width:46ch}
.tagline{display:inline-block;font-weight:600;color:var(--sun);margin-bottom:12px}

.btn{display:inline-flex;align-items:center;gap:8px;text-decoration:none;font:600 1rem var(--body);padding:14px 26px;border-radius:99px;border:2px solid var(--sun);cursor:pointer;transition:transform .15s,background .15s,color .15s}
.btn.pri{background:var(--sun);color:#0a1330}
.btn.pri:hover{background:#ffd966}
.btn.sec{background:transparent;color:var(--text);border-color:var(--line)}
.btn.sec:hover{border-color:var(--sky);color:var(--sky)}
.btn:active{transform:scale(.97)}

/* header */
header{position:sticky;top:12px;z-index:50;padding:0 clamp(10px,2vw,24px)}
.bar{max-width:1180px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:16px;background:rgba(15,27,68,.86);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid var(--line);border-radius:99px;padding:8px 10px 8px 24px}
.logo{font-family:var(--display);font-weight:800;font-size:1.2rem;text-decoration:none}
.logo i{font-style:normal;color:var(--sun)}
nav ul{display:flex;gap:2px}
nav a{display:block;text-decoration:none;padding:8px 14px;border-radius:99px;font-weight:500;font-size:.95rem;color:var(--muted)}
nav a:hover{color:var(--text);background:var(--card)}
.bar .btn{padding:10px 20px;font-size:.95rem}
.menu{display:none;background:none;border:2px solid var(--line);color:var(--text);border-radius:99px;width:44px;height:44px;cursor:pointer;font-size:1.2rem}
@media(max-width:900px){
  .menu{display:block;margin-left:auto}
  .bar .btn{display:none}
  nav{position:absolute;left:clamp(10px,2vw,24px);right:clamp(10px,2vw,24px);top:calc(100% + 8px);background:var(--bg2);border:1px solid var(--line);border-radius:24px;padding:10px;display:none}
  nav.open{display:block}
  nav ul{flex-direction:column}
  nav a{padding:14px 16px}
}

/* hero */
.hero{padding-top:clamp(40px,6vw,72px);padding-bottom:0}
.hero .wrap{display:grid;grid-template-columns:1.2fr 1fr;gap:40px;align-items:center}
.hi{color:var(--sky);font-weight:600;margin-bottom:14px}
.hero h1{font-size:clamp(2.7rem,6.6vw,5.4rem);font-weight:800;letter-spacing:-.04em;line-height:.98}
.hero h1 em{font-style:normal;color:var(--sun);white-space:nowrap}
.hero p.sub{color:var(--muted);max-width:50ch;margin:24px 0 32px;font-size:1.12rem}
.hero .btns{display:flex;flex-wrap:wrap;gap:12px}
.pic{position:relative;justify-self:center;width:min(100%,300px)}
.pic img{width:100%;height:auto;aspect-ratio:5/6;object-fit:cover;object-position:50% 12%;border-radius:999px 999px 28px 28px;border:2px solid var(--line)}
.pic::before{content:"";position:absolute;inset:12px -12px -12px 12px;border-radius:999px 999px 28px 28px;background:var(--sun);z-index:-1}
.badge{position:absolute;background:var(--card);border:1px solid var(--line);border-radius:18px;padding:12px 18px;box-shadow:0 12px 30px rgba(0,0,0,.35)}
.badge b{display:block;font-family:var(--display);font-size:1.7rem;font-weight:800;line-height:1}
.badge span{font-size:.88rem;color:var(--muted)}
.b1{left:-72px;top:70px}
.b2{right:-64px;bottom:56px}
@media(max-width:900px){
  .hero .wrap{grid-template-columns:1fr}
  .pic{width:min(60%,230px);margin-top:8px}
  .badge{display:none}
}

/* ticker */
.ticker{margin-top:clamp(48px,7vw,88px);background:var(--sun);color:#0a1330;overflow:hidden;transform:rotate(-1.4deg);padding:16px 0;border-top:2px solid #0a1330;border-bottom:2px solid #0a1330}
.track{display:flex;gap:0;width:max-content;animation:slide 32s linear infinite}
.track span{font-family:var(--display);font-weight:800;font-size:clamp(1.3rem,2.6vw,2rem);letter-spacing:-.01em;padding:0 28px;position:relative;white-space:nowrap}
.track span::after{content:"";position:absolute;right:-6px;top:50%;width:12px;height:12px;margin-top:-6px;background:#0a1330;transform:rotate(45deg)}
@keyframes slide{to{transform:translateX(-50%)}}

/* work */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:24px}
.proj{background:var(--card);border:1px solid var(--line);border-radius:24px;overflow:hidden;display:flex;flex-direction:column;transition:transform .2s,border-color .2s}
.proj:hover{transform:translateY(-4px);border-color:var(--sky)}
.shot{height:190px;position:relative;display:grid;place-items:center;padding:20px}
.shot::before{content:"";position:absolute;left:18px;top:14px;width:9px;height:9px;border-radius:50%;background:#fff;opacity:.7;box-shadow:16px 0 0 #fff,32px 0 0 #fff}
.shot strong{font-family:var(--display);font-weight:800;font-size:clamp(1.5rem,3vw,2rem);letter-spacing:-.03em;text-align:center;color:#0a1330}
.c1{background:var(--sky)}.c2{background:var(--sun)}.c3{background:#b9f0d4}.c4{background:#ffb8a8}.c5{background:#d3c4ff}.c6{background:#bfe3ff}.c7{background:#ffe3a1}
.proj .body{padding:24px 26px 28px;display:flex;flex-direction:column;gap:10px;flex:1}
.kind{color:var(--sky);font-weight:600;font-size:.92rem}
.proj h3{font-size:1.45rem;font-weight:700}
.proj h3 a{text-decoration:none}
.proj h3 a:hover{text-decoration:underline;text-decoration-color:var(--sun);text-decoration-thickness:3px}
.proj p{color:var(--muted);font-size:1rem}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:auto;padding-top:8px}
.chips span{font-size:.82rem;font-weight:600;background:var(--bg);border:1px solid var(--line);padding:4px 11px;border-radius:99px;color:var(--text)}

/* cta */
.cta{padding:0 0 clamp(56px,8vw,104px)}
.cta .box{background:var(--sky);color:#0a1330;border-radius:32px;padding:clamp(32px,5vw,60px);display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:24px}
.cta h2{font-size:clamp(1.8rem,4vw,3rem);max-width:18ch}
.cta .btn{background:#0a1330;color:#fff;border-color:#0a1330}
.cta .btn:hover{background:#1b2d66}

/* facts */
.facts{background:var(--bg2)}
.fgrid{display:grid;grid-template-columns:1fr 1.3fr;gap:48px;align-items:center}
.nums{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.num{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:26px}
.num b{display:block;font-family:var(--display);font-weight:800;font-size:clamp(2.2rem,4.4vw,3.4rem);line-height:1;color:var(--sun)}
.num span{color:var(--muted);font-size:.96rem;display:block;margin-top:8px}
.why{display:grid;gap:22px;margin-top:28px}
.why div{border-left:3px solid var(--sun);padding-left:20px}
.why h3{font-size:1.25rem;font-weight:700;margin-bottom:4px}
.why p{color:var(--muted)}
@media(max-width:900px){.fgrid{grid-template-columns:1fr}}

/* tools */
.tools{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:14px}
.tool{display:flex;align-items:center;gap:12px;background:var(--card);border:1px solid var(--line);border-radius:18px;padding:14px 16px}
.tool i{font-style:normal;flex:none;width:40px;height:40px;border-radius:12px;display:grid;place-items:center;font-family:var(--display);font-weight:800;color:#0a1330;background:var(--sky)}
.tool:nth-child(3n) i{background:var(--sun)}
.tool:nth-child(3n+2) i{background:#b9f0d4}
.tool b{font-weight:600;font-size:.98rem;line-height:1.2}
.tool small{display:block;color:var(--muted);font-size:.8rem;font-weight:400}

/* services */
.services{background:var(--bg2)}
.svc{border-top:1px solid var(--line)}
.svc li{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.3fr);gap:12px 40px;align-items:baseline;padding:30px 0;border-bottom:1px solid var(--line);transition:padding .2s,background .2s}
.svc li:hover{padding-left:18px;background:linear-gradient(90deg,rgba(143,187,255,.08),transparent)}
.svc h3{font-size:clamp(1.3rem,2.6vw,1.9rem);font-weight:700}
.svc p{color:var(--muted)}
@media(max-width:760px){.svc li{grid-template-columns:1fr}}

/* about */
.about{display:grid;grid-template-columns:1fr 1.2fr;gap:48px;align-items:center}
.about img{width:100%;height:auto;max-width:400px;aspect-ratio:1;object-fit:cover;object-position:50% 14%;border-radius:32px;border:2px solid var(--line)}
.quote{font-family:var(--display);font-weight:700;font-size:clamp(1.5rem,3vw,2.2rem);line-height:1.15;letter-spacing:-.02em;margin:10px 0 20px}
.about p.t{color:var(--muted);max-width:56ch}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin:28px 0}
.cards a{display:block;text-decoration:none;background:var(--card);border:1px solid var(--line);border-radius:18px;padding:16px 20px;word-break:break-word}
.cards a:hover{border-color:var(--sky)}
.cards small{color:var(--muted);display:block}
.cards b{font-weight:600}
@media(max-width:900px){.about{grid-template-columns:1fr}}

/* journey */
.journey{background:var(--bg2)}
.cols{display:grid;grid-template-columns:1fr 1.25fr;gap:56px}
.cols h3{font-size:1.6rem;font-weight:800;margin-bottom:26px}
.tl{border-left:2px solid var(--line);margin-left:6px}
.tl li{position:relative;padding:0 0 32px 28px}
.tl li:last-child{padding-bottom:0}
.tl li::before{content:"";position:absolute;left:-9px;top:7px;width:16px;height:16px;border-radius:50%;background:var(--sun);border:3px solid var(--bg2)}
.tl time{color:var(--sky);font-weight:600;font-size:.92rem}
.tl h4{font-size:1.25rem;font-weight:700;margin:2px 0 8px}
.tl ul{color:var(--muted);padding-left:18px;list-style:disc}
.tl ul li{padding:0;margin-top:4px}
.tl ul li::before{display:none}
.tl p{color:var(--muted)}
@media(max-width:900px){.cols{grid-template-columns:1fr}}

/* process */
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px}
.step{background:var(--card);border:1px solid var(--line);border-radius:24px;padding:30px}
.step .n{display:inline-grid;place-items:center;width:44px;height:44px;border-radius:50%;background:var(--sun);color:#0a1330;font-family:var(--display);font-weight:800;margin-bottom:16px}
.step h3{font-size:1.5rem;font-weight:700;margin-bottom:10px}
.step p{color:var(--muted);margin-bottom:14px}
.step li{padding-left:26px;position:relative;margin-top:6px}
.step li::before{content:"✓";position:absolute;left:0;color:var(--sun);font-weight:700}

/* contact */
.contact{background:var(--bg2)}
.cgrid{display:grid;grid-template-columns:1fr 1.1fr;gap:48px}
.contact .lede{color:var(--muted);margin:14px 0 26px;max-width:46ch}
.links{display:grid;gap:12px}
.links a{display:block;text-decoration:none;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px 20px}
.links a:hover{border-color:var(--sky)}
.links b{display:block;font-family:var(--display);font-size:1.1rem}
.links span{color:var(--muted);font-size:.93rem;word-break:break-all}
form{background:var(--card);border:1px solid var(--line);border-radius:24px;padding:clamp(22px,4vw,36px);display:grid;gap:16px}
label{display:grid;gap:6px;font-weight:600;font-size:.95rem}
input,textarea{font:inherit;background:var(--bg);color:var(--text);border:1px solid var(--line);border-radius:14px;padding:13px 16px;width:100%}
input:focus,textarea:focus{outline:3px solid var(--sun);outline-offset:1px;border-color:var(--sun)}
textarea{min-height:130px;resize:vertical}
.note{color:var(--muted);font-size:.88rem;font-weight:400}
@media(max-width:900px){.cgrid{grid-template-columns:1fr}}

/* footer */
footer{padding:56px 0 28px;border-top:1px solid var(--line)}
.fcols{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:36px}
.fcols h4{font-size:1.05rem;margin-bottom:12px;color:var(--sun)}
.fcols a{text-decoration:none;color:var(--muted);display:block;padding:3px 0}
.fcols a:hover{color:var(--text)}
.fcols p{color:var(--muted);max-width:34ch;margin-top:10px}
.copy{margin-top:40px;padding-top:22px;border-top:1px solid var(--line);color:var(--muted);font-size:.92rem}
@media(max-width:800px){.fcols{grid-template-columns:1fr 1fr}.fcols>div:first-child{grid-column:1/-1}}

/* mobile quick-contact bar */
.dock{display:none}
@media(max-width:700px){
  body{font-size:1rem;padding-bottom:76px}
  section{padding:48px 0}
  .btn{padding:15px 24px}
  .hero .btns .btn{flex:1 1 100%;justify-content:center}
  .head{margin-bottom:28px}
  .grid{grid-template-columns:1fr}
  .shot{height:150px}
  .nums{gap:12px}
  .num{padding:20px}
  .tools{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .tool b{min-width:0;overflow-wrap:anywhere}
  .tool i{width:34px;height:34px}
  .tool{padding:12px}
  .about img{max-width:100%}
  .cards{grid-template-columns:1fr}
  .ticker{transform:none}
  .cta .btn{width:100%;justify-content:center}
  .dock{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;position:fixed;left:10px;right:10px;bottom:calc(10px + env(safe-area-inset-bottom,0px));z-index:60;background:rgba(15,27,68,.94);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid var(--line);border-radius:99px;padding:8px}
  .dock a{text-align:center;text-decoration:none;font-weight:600;padding:12px 6px;border-radius:99px;background:var(--card)}
  .dock a:first-child{background:var(--sun);color:#0a1330}
}
@media(min-width:1400px){
  .wrap,.bar{max-width:1320px}
  .hero h1{font-size:6rem}
}
@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .track{animation:none}
  *{transition:none!important}
}
</style>
</head>
