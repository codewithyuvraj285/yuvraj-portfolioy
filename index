<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Yuvraj Ayangar — Digital Marketer, Full-Stack & WordPress Developer</title>
<meta name="description" content="Yuvraj Ayangar builds websites, AI automations and ad campaigns. 50+ client projects, 95% client retention. WordPress, Next.js, N8N, Google & Meta Ads.">
<meta property="og:title" content="Yuvraj Ayangar — Digital Marketer & Full-Stack Developer">
<meta property="og:description" content="Websites, AI automations and ad campaigns that bring in customers.">
<meta property="og:type" content="website">
